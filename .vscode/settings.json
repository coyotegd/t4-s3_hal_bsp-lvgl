{
  // Portable VS Code settings: avoid user-specific absolute paths
  "C_Cpp.intelliSenseEngine": "default",
  "idf.pythonInstallPath": "/usr/bin/python3",
  "idf.openOcdConfigs": [
    "board/esp32s3-builtin.cfg"
  ],
  // Serial port should be selected per-user (or via -p on CLI)
  // "idf.port": "",
  // Do not hardcode local IDF install locations; extension/env will provide these
  // "idf.espIdfPath": "",
  // "idf.toolsPath": "",
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32s3"
  },
  // Use generic query-driver and workspace-relative compile commands dir
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build"
  ],
  "idf.flashType": "UART",
  "idf.buildPath": "${workspaceFolder}/build"
}
